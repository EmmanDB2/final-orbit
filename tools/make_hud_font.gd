# make_hud_font.gd: adds lowercase, punctuation, brackets, a middle dot, and small raised digits to
# art/hud_font.png, on the same 5 x 7 grid as its capitals and numbers, doubled to 10 x 14. From
# DESIGN.md, "UI". Only needs running again if a glyph changes. Run with:
#   godot --headless --path . --script tools/make_hud_font.gd
extends SceneTree

## How many glyphs at the start of the file were drawn by hand in the image itself.
const KEPT: int = 36
const CELL := Vector2i(10, 14)
const GLYPHS: Array = [
	["a", ".....", ".....", ".###.", "....#", ".####", "#...#", ".####"],
	["b", "#....", "#....", "####.", "#...#", "#...#", "#...#", "####."],
	["c", ".....", ".....", ".###.", "#....", "#....", "#...#", ".###."],
	["d", "....#", "....#", ".####", "#...#", "#...#", "#...#", ".####"],
	["e", ".....", ".....", ".###.", "#...#", "#####", "#....", ".###."],
	["f", "..##.", ".#..#", ".#...", "###..", ".#...", ".#...", ".#..."],
	["g", ".....", ".####", "#...#", "#...#", ".####", "....#", ".###."],
	["h", "#....", "#....", "####.", "#...#", "#...#", "#...#", "#...#"],
	["i", "..#..", ".....", ".##..", "..#..", "..#..", "..#..", ".###."],
	["j", "...#.", ".....", "..##.", "...#.", "...#.", "#..#.", ".##.."],
	["k", "#....", "#....", "#..#.", "#.#..", "##...", "#.#..", "#..#."],
	["l", ".##..", "..#..", "..#..", "..#..", "..#..", "..#..", ".###."],
	["m", ".....", ".....", "##.#.", "#.#.#", "#.#.#", "#.#.#", "#.#.#"],
	["n", ".....", ".....", "####.", "#...#", "#...#", "#...#", "#...#"],
	["o", ".....", ".....", ".###.", "#...#", "#...#", "#...#", ".###."],
	["p", ".....", "####.", "#...#", "#...#", "####.", "#....", "#...."],
	["q", ".....", ".####", "#...#", "#...#", ".####", "....#", "....#"],
	["r", ".....", ".....", "#.##.", "##..#", "#....", "#....", "#...."],
	["s", ".....", ".....", ".####", "#....", ".###.", "....#", "####."],
	["t", ".#...", ".#...", "###..", ".#...", ".#...", ".#..#", "..##."],
	["u", ".....", ".....", "#...#", "#...#", "#...#", "#..##", ".##.#"],
	["v", ".....", ".....", "#...#", "#...#", "#...#", ".#.#.", "..#.."],
	["w", ".....", ".....", "#...#", "#...#", "#.#.#", "#.#.#", ".#.#."],
	["x", ".....", ".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#"],
	["y", ".....", "#...#", "#...#", "#...#", ".####", "....#", ".###."],
	["z", ".....", ".....", "#####", "...#.", "..#..", ".#...", "#####"],
	[":", ".....", "..#..", "..#..", ".....", "..#..", "..#..", "....."],
	["+", ".....", "..#..", "..#..", "#####", "..#..", "..#..", "....."],
	["-", ".....", ".....", ".....", "#####", ".....", ".....", "....."],
	[".", ".....", ".....", ".....", ".....", ".....", ".##..", ".##.."],
	[",", ".....", ".....", ".....", ".....", ".##..", "..#..", ".#..."],
	["(", "...#.", "..#..", ".#...", ".#...", ".#...", "..#..", "...#."],
	[")", ".#...", "..#..", "...#.", "...#.", "...#.", "..#..", ".#..."],
	["/", "....#", "....#", "...#.", "..#..", ".#...", "#....", "#...."],
	["%", "##..#", "##..#", "...#.", "..#..", ".#...", "#..##", "#..##"],
	["?", ".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.."],
	["'", "..#..", "..#..", ".#...", ".....", ".....", ".....", "....."],
	["!", "..#..", "..#..", "..#..", "..#..", "..#..", ".....", "..#.."],
	["×", ".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "....."],
	["Δ", "..#..", "..#..", ".#.#.", ".#.#.", "#...#", "#...#", "#####"],
	["°", ".##..", "#..#.", "#..#.", ".##..", ".....", ".....", "....."],
	["⁰", "###..", "#.#..", "#.#..", "#.#..", "###..", ".....", "....."],
	["¹", ".#...", "##...", ".#...", ".#...", "###..", ".....", "....."],
	["²", "###..", "..#..", "###..", "#....", "###..", ".....", "....."],
	["³", "###..", "..#..", "###..", "..#..", "###..", ".....", "....."],
	["⁴", "#.#..", "#.#..", "###..", "..#..", "..#..", ".....", "....."],
	["⁵", "###..", "#....", "###..", "..#..", "###..", ".....", "....."],
	["⁶", "###..", "#....", "###..", "#.#..", "###..", ".....", "....."],
	["⁷", "###..", "..#..", ".#...", ".#...", ".#...", ".....", "....."],
	["⁸", "###..", "#.#..", "###..", "#.#..", "###..", ".....", "....."],
	["⁹", "###..", "#.#..", "###..", "..#..", "###..", ".....", "....."],
	["[", ".###.", ".#...", ".#...", ".#...", ".#...", ".#...", ".###."],
	["]", ".###.", "...#.", "...#.", "...#.", "...#.", "...#.", ".###."],
	["&", ".##..", "#..#.", "#.#..", ".#...", "#.#.#", "#..#.", ".##.#"],
	["_", ".....", ".....", ".....", ".....", ".....", ".....", "#####"],
	["<", "...#.", "..#..", ".#...", "#....", ".#...", "..#..", "...#."],
	[">", ".#...", "..#..", "...#.", "....#", "...#.", "..#..", ".#..."],
	["#", ".#.#.", ".#.#.", "#####", ".#.#.", "#####", ".#.#.", ".#.#."],
	[";", ".....", "..#..", "..#..", ".....", "..#..", "..#..", ".#..."],
	["·", ".....", ".....", ".....", "..#..", ".....", ".....", "....."],
]


func _initialize() -> void:
	var path: String = ProjectSettings.globalize_path("res://art/hud_font.png")
	var old: Image = Image.load_from_file(path)
	old.convert(Image.FORMAT_RGBA8)
	var image := Image.create((KEPT + GLYPHS.size()) * CELL.x, CELL.y, false, Image.FORMAT_RGBA8)
	image.blit_rect(old, Rect2i(0, 0, KEPT * CELL.x, CELL.y), Vector2i.ZERO)
	var characters: String = ""
	for g in range(GLYPHS.size()):
		var glyph: Array = GLYPHS[g]
		characters += glyph[0]
		for row in range(7):
			var line: String = glyph[row + 1]
			for column in range(5):
				if line[column] == "#":
					image.fill_rect(Rect2i((KEPT + g) * CELL.x + column * 2, row * 2, 2, 2), Color.WHITE)
	image.save_png(path)
	print(characters)
	quit()
