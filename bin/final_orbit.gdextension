[configuration]

entry_symbol = "final_orbit_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://bin/libfinalorbit.macos.template_debug.arm64.dylib"
macos.release = "res://bin/libfinalorbit.macos.template_release.arm64.dylib"
android.debug.arm64 = "res://bin/libfinalorbit.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libfinalorbit.android.template_release.arm64.so"
